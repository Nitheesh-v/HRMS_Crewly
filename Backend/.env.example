

# ---- INFOLEXUS HRMS Backend Environment ----
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (paste yours here in your .env file)
MONGO_URI=

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Will be used from Phase 1 (JWT auth)
JWT_SECRET=
JWT_EXPIRES_IN=


# Phase 8 — optional: real Razorpay payments (leave empty = TEST MODE)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Phase 8 — optional: real emails via SMTP (empty = MOCK only in development/test; production fails closed)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=



CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 27.5 — private candidate resume storage (1–10 MB, default 5)
MAX_RESUME_SIZE_MB=5
# Development-only local private path when Cloudinary is unavailable
PRIVATE_RESUME_STORAGE_DIR=private_storage/resumes

# Phase 27.11 — secure offer document/token controls
# Local private storage is used only in development/test when Cloudinary is unavailable.
PRIVATE_OFFER_STORAGE_DIR=private_storage/offers
OFFER_TOKEN_MAX_DAYS=90

# Phase 27.12 — secure pre-onboarding documents and candidate portal tokens
PRIVATE_PRE_ONBOARDING_STORAGE_DIR=private_storage/pre-onboarding
PRE_ONBOARDING_TOKEN_MAX_DAYS=90
MAX_PRE_ONBOARDING_DOC_SIZE_MB=5
FIELD_ENCRYPTION_KEY=

# Phase 27.6 — deterministic resume extraction safety and retry controls
RESUME_PARSE_MAX_RAW_TEXT_CHARS=250000
RESUME_PARSE_MAX_DOCX_EXPANDED_BYTES=52428800
RESUME_PARSE_MAX_PDF_PAGES=100
RESUME_PARSE_TIMEOUT_MS=30000
RESUME_PARSE_MAX_ATTEMPTS=8
RESUME_PARSE_LEASE_MS=300000
RESUME_REPROCESS_COOLDOWN_MS=60000

# Phase 27.7 — explainable ATS matching weights (worker-side dispatch since 28.4)
ATS_WEIGHT_REQUIRED_SKILLS=40
ATS_WEIGHT_EXPERIENCE=25
ATS_WEIGHT_PREFERRED_SKILLS=15
ATS_WEIGHT_EDUCATION=10
ATS_WEIGHT_LOCATION_NOTICE=10
ATS_DEFAULT_MAX_NOTICE_PERIOD_DAYS=30

# Phase 28 — Redis infrastructure (managed Redis, provider neutral)
# The real connection URL (redis:// or rediss://) lives ONLY in your local Backend/.env.
# The API runs without Redis (business state stays in Mongo; queue dispatch is
# deferred to worker startup / `npm run processing:reconcile`), but the worker
# process REQUIRES Redis. Enable it for email + resume/ATS background jobs.
REDIS_ENABLED=false
REDIS_URL=
# Optional: startup connection timeout in milliseconds (default 10000, clamped 1000-60000)
REDIS_CONNECT_TIMEOUT_MS=10000

# Phase 28.2 — BullMQ queue/worker foundation
# Redis key namespace for queues. Defaults to crewly:<NODE_ENV> (e.g. crewly:development).
# Keep every environment separate; never share a queue namespace across environments.
BULLMQ_PREFIX=
# System worker concurrency (default 2, clamped 1-50). Future workload workers get their own variables.
WORKER_CONCURRENCY=2
# Email worker concurrency (28.3). Default 2, clamped 1-10.
# Kept low on purpose: SMTP providers rate-limit sending.
EMAIL_WORKER_CONCURRENCY=2
# Resume parsing worker concurrency (28.4). Default 1, clamped 1-4.
# PDF/DOCX extraction is CPU-bound — single-flight by default so one
# large file cannot starve the process or other tenants' jobs.
RESUME_WORKER_CONCURRENCY=1
# ATS matching worker concurrency (28.4). Default 2, clamped 1-10.
ATS_WORKER_CONCURRENCY=2
# Phase 28.5 — scheduled (delayed) jobs
# Scheduled worker concurrency (interview reminders, offer expiry
# reminders, offer expiry). Default 4, clamped 1-10. Jobs are light:
# Mongo validation + email-intent dispatch / one atomic transition.
SCHEDULED_WORKER_CONCURRENCY=4
# Offer expiry reminder offset in hours (one candidate nudge at
# expiry minus this window). Default 48, clamped 1-168. Offers sent
# inside that window get no reminder (the offer email is the notice).
# Interview reminders follow their own policy (24h -> 1h -> immediate).
OFFER_REMINDER_OFFSET_HOURS=48
# Phase 28.6 — pre-onboarding documents + background verification
# Documents worker concurrency (stored document processing). Default
# 2, clamped 1-8. Jobs are bounded (15 MB max) but do storage reads.
DOCUMENT_WORKER_CONCURRENCY=2
# BGV worker concurrency (provider registration + polling). Default
# 2, clamped 1-8. Kept modest on purpose: external providers must
# not be hammered with parallel calls.
BGV_WORKER_CONCURRENCY=2
# Pre-onboarding reminder offsets (candidate nudge timing).
# Hours after pre-onboarding starts to nudge pending documents.
# Default 72, clamped 12-336.
PREONBOARDING_DOCS_REMINDER_HOURS=72
# Hours after a document rejection to nudge resubmission.
# Default 48, clamped 6-336.
PREONBOARDING_RESUBMISSION_REMINDER_HOURS=48
# Days before the joining date to send the final documents nudge.
# Default 3, clamped 1-14.
PREONBOARDING_JOINING_REMINDER_DAYS_BEFORE=3
# BGV reminder offsets. Hours after consent is required (case start)
# to nudge the candidate, and after assignment / review-required to
# nudge HR. Defaults 48 / 72, clamped 12-336.
BGV_CANDIDATE_REMINDER_HOURS=48
BGV_VERIFIER_REMINDER_HOURS=72
# Phase 28.7 — recruitment analytics cache TTL (seconds).
# Default 60, clamped 10-3600. Set 0 to disable the analytics cache
# entirely (reads still work — the cache is an optimization only).
RECRUITMENT_ANALYTICS_CACHE_TTL_SECONDS=60

# ============================================================
# Phase 29.1 — Company Payroll Setup (configuration layer)
# ============================================================
# Payroll configuration cache TTL (seconds). Default 300, clamped 10-3600.
# MongoDB is always the source of truth; Redis is only a cache. If Redis is
# unavailable the configuration is still read from MongoDB.
PAYROLL_SETUP_CACHE_TTL_SECONDS=300

# ============================================================
# Phase 28.8 — Queue Operations (Super Admin "Background Operations")
# All optional — the built-in defaults are sane and clamped in code.
# ============================================================
# Waiting-job count thresholds per queue (WARNING / CRITICAL).
# OPS_QUEUE_WAITING_WARN=100
# OPS_QUEUE_WAITING_CRITICAL=1000
# Oldest waiting job age thresholds in milliseconds
# (default 5 minutes warning / 30 minutes critical).
# OPS_OLDEST_WAITING_WARN_MS=300000
# OPS_OLDEST_WAITING_CRITICAL_MS=1800000
# "Recently failed" window for the ops overview (minutes, default 15).
# OPS_FAILED_RECENT_MINUTES=15
# Worker heartbeat: beat interval (ms, clamped 5000-60000, default 15000)
# and key TTL (seconds, clamped 15-300, default 60). Keep TTL >= 3x
# the interval. A worker showing OFFLINE means its key expired.
# OPS_WORKER_HEARTBEAT_INTERVAL_MS=15000
# OPS_WORKER_HEARTBEAT_TTL_SECONDS=60

# ============================================================
# Phase 29.6 — Payroll Calculation Engine
# ============================================================
# Payroll run cache TTL (seconds). Default 300, clamped 10-3600.
# Caches the dashboard summary (§23); invalidated on every run,
# recalculation and status change. MongoDB is the source of truth.
PAYROLL_RUN_CACHE_TTL_SECONDS=300
# Payroll worker concurrency (monthly salary calculation). Default 2,
# clamped 1-8. One run at a time per slot by design: payroll is
# Mongo-heavy and must not starve the API's own queries.
PAYROLL_WORKER_CONCURRENCY=2
