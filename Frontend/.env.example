# Local development: point at your local Backend (Phase 27.12 lives here).
# Production builds may override this with the deployed API URL.
VITE_API_URL=http://localhost:5000/api
VITE_MAX_RESUME_SIZE_MB=5

# 36.8 — the chat socket. It is DERIVED from VITE_API_URL's origin, so on a
# normal deploy (SPA and API on different hosts) you set nothing extra here
# and realtime keeps working. Set it only when the realtime host genuinely
# differs from the API host. Leave it empty locally: with no VITE_API_URL the
# socket uses the page origin, which is what the Vite proxy forwards.
#
# WHY THIS EXISTS AT ALL: with no URL, socket.io connects to the page's own
# origin. Behind a static host (Vercel) that origin has no Socket.IO server,
# every handshake is refused, and chat degrades to read-only REST while the
# rest of the app looks perfectly healthy.
VITE_SOCKET_URL=
